<mujoco model="g1_43dof tennis scene">
  <include file="g1_29dof_with_hand_tennis.xml"/>
  <!-- Note that the hand model in g1_29dof_with_hand.xml is not stable for simulation. -->

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Tennis -->
    <material name="hard_court" rgba="0.325 0.42 0.333 1" reflectance="0.05"/>
    <material name="court_line" rgba="0.95 0.95 0.95 1"/>
    <!-- End Tennis-->
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.001" type="plane" material="groundplane"/>
    
    <!-- Tennis -->
    <geom name="tennis_floor" pos="9.885 2 0.002" size="10.885 5.485 0.05" type="plane" material="hard_court" friction="1.0 0.005 0.0001" condim="3" />

    <!-- Lines: visual only, raised, non-colliding -->
    <geom name="baseline_player" type="box" size="0.025 5.485 0.003" pos="-1.000 2 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>
    <geom name="baseline_opponent" type="box" size="0.025 5.485 0.003" pos="20.770 2 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>

    <geom name="center_line_player" type="box" size="0.1 0.025 0.003" pos="-0.900 2 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>
    <geom name="center_line_opponent" type="box" size="0.1 0.025 0.003" pos="20.670 2 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>

    <geom name="double_side_right" type="box" size="10.855 0.025 0.003" pos="9.885 -3.485 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>
    <geom name="double_side_left" type="box" size="10.855 0.025 0.003" pos="9.885 7.485 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>

    <geom name="single_side_right" type="box" size="10.855 0.025 0.003" pos="9.885 -2.110 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>
    <geom name="single_side_left" type="box" size="10.855 0.025 0.003" pos="9.885 6.110 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>

    <geom name="service_line_player" type="box" size="0.025 4.110 0.003" pos="3.485 2 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>
    <geom name="service_line_opponent" type="box" size="0.025 4.110 0.003" pos="16.285 2 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>

    <geom name="center_service_line" type="box" size="6.40 0.025 0.003" pos="9.885 2 0.001" material="court_line" contype="0" conaffinity="0" group="1"/>

    <!-- Net: thin, collidable, soft contact so the ball drops on contact -->
    <geom name="net" type="box" size="0.02 5.03 0.530" pos="9.885 2 0.530" rgba="0.9 0.9 0.9 0.6" solref="0.05 1" solimp="0.6 0.9 0.01"/>
    <geom name="post_right" type="cylinder" size="0.0725 0.530" pos="9.885 -3.095 0.530" rgba="0.2 0.2 0.2 1"/>
    <geom name="post_left" type="cylinder" size="0.0725 0.530" pos="9.885 7.095 0.530" rgba="0.2 0.2 0.2 1"/>
    <!-- End Tennis -->

  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
